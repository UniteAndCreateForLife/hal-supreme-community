# Copy to .env and fill values. NEVER commit .env or real tokens.
# cp .env.example .env

# Gateway auth (preferred). Leave empty to use secret file mount below.
HAL_GATEWAY_TOKEN=

# Or point compose at a token file (default: ./secrets/hal_gateway_token)
# HAL_GATEWAY_TOKEN_HOST_FILE=./secrets/hal_gateway_token

# Cloud-first routing (default ON)
HAL_CLOUD_FIRST=1

# Host port during dual-run with Windows gateway (Windows keeps 8766)
HAL_GATEWAY_HOST_PORT=8767

# Public URL used in generated image markdown
HAL_PUBLIC_API_BASE=https://api.halsupreme.com

# Optional Piper voices bind-mount (omit / leave default; ~240MB)
# HAL_VOICES_HOST_PATH=./voices

# Provider API keys used by opencode_config.json ($GROQ_API_KEY etc.)
# At least one healthy remote key is required for cloud-first chat.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HUGGINGFACE_API_KEY=
GITHUB_TOKEN=
XAI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
SAMBANOVA_API_KEY=
NEBIUS_API_KEY=
SILICONFLOW_API_KEY=
